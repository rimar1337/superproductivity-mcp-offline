# ── Nextcloud / WebDAV connection ────────────────────────────────────────────
# Base URL of your Nextcloud instance (no trailing path).
# The DAV root is derived as {SP_NEXTCLOUD_URL}/remote.php/dav/files/{SP_NEXTCLOUD_USER}/
SP_NEXTCLOUD_URL=https://cloud.example.com
SP_NEXTCLOUD_USER=yourname

# App password (Settings → Security → Devices & sessions → Create new app password).
# Strongly preferred over your login password: it is scoped, revocable, and works
# when two-factor authentication is enabled.
SP_NEXTCLOUD_PASSWORD=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx

# Optional: DAV login name, when your instance accepts an email address for login
# but stores files under a different username.
# SP_NEXTCLOUD_LOGIN_NAME=you@example.com

# ── Sync file location ───────────────────────────────────────────────────────
# Folder inside your Nextcloud that Super Productivity syncs to.
SP_SYNC_FOLDER=super-productivity

# ── Encryption ───────────────────────────────────────────────────────────────
# Only set this if you enabled "Encryption" in Super Productivity's sync settings.
# Must be the exact same password, or the sync file cannot be read.
# SP_ENCRYPTION_PASSWORD=

# ── Behaviour ────────────────────────────────────────────────────────────────
# read-only  → every write tool is rejected before it touches the network.
# read-write → full CRUD (default).
SP_MODE=read-write

# Client id this server presents to Super Productivity's vector clock.
# Leave unset to derive a stable one automatically. Must be unique per machine.
# SP_CLIENT_ID=

# Seconds to serve a cached read before re-fetching from WebDAV. 0 disables caching.
SP_CACHE_TTL_SECONDS=20

# Log level: silent | error | warn | info | debug
SP_LOG_LEVEL=info

# ── E2E tests only ───────────────────────────────────────────────────────────
# Folder used by `npm run test:e2e`. MUST be different from SP_SYNC_FOLDER:
# the suite creates, overwrites and deletes files inside it.
SP_E2E_FOLDER=super-productivity-mcp-e2e
